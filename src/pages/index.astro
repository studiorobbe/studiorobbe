---
import BaseLayout from '../layouts/BaseLayout.astro';

const currentYear = new Date().getFullYear();
---

<BaseLayout
	title="studio rob•be"
	description="Studio rob•be is an industrial design and product development studio."
>
	<main>
		<h1>studio rob•be</h1>
		<p>Coming Soon</p>
	</main>
	<footer>&copy; {currentYear} studio rob•be</footer>
</BaseLayout>

<style>
	:global(body) {
		display: grid;
		min-height: 100vh;
		grid-template-rows: 1fr auto;
	}

	main,
	footer {
		padding: 2rem;
	}

	main {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	h1,
	p {
		margin: 0;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 7rem);
		font-weight: 500;
		letter-spacing: -0.05em;
	}

	p,
	footer {
		font-size: 0.875rem;
	}

	p {
		margin-top: 1rem;
	}
</style>
